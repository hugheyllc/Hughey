<style>
  .footer { background: var(--ink); color: var(--white); padding: 4rem 2rem 2rem; margin-top: 6rem; }
  .footer-content { max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 3rem; margin-bottom: 2rem; }
  .footer-column { }
  .footer-column h3 { font-size: 1rem; font-weight: 600; margin-bottom: 1rem; color: var(--gold); }
  .footer-column p { font-size: 0.9rem; line-height: 1.6; color: rgba(255, 255, 255, 0.7); }
  .footer-column p a { color: var(--gold); }
  .footer-links { list-style: none; }
  .footer-links li { margin-bottom: 0.75rem; }
  .footer-links a { font-size: 0.9rem; color: rgba(255, 255, 255, 0.8); transition: color 0.3s ease; }
  .footer-links a:hover { color: var(--gold); }
  .footer-bottom { border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: 2rem; text-align: center; font-size: 0.85rem; color: rgba(255, 255, 255, 0.6); }
</style>
