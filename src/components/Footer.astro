      <p style="margin-top: 1rem; font-size: 0.9rem;">
        5412 Dover St NE<br />
        St. Petersburg, FL 33703<br />
        <a href="tel:727-483-3222">727-483-3222</a>
      </p>
    </div>

    <div class="footer-column">
      <h3>Services</h3>
      <ul class="footer-links">
        <li><a href="/services/data-analysis-for-law-firms">Data Analysis</a></li>
        <li><a href="/services/agency-management-for-law-firms">Agency Management</a></li>
        <li><a href="/services/intake-process-optimization">Intake Optimization</a></li>
        <li><a href="/services/strategic-marketing-for-law-firms">Strategic Marketing</a></li>
      </ul>
    </div>

    <div class="footer-column">
      <h3>Explore</h3>
      <ul class="footer-links">
        <li><a href="/about">About</a></li>
        <li><a href="/insights">Insights</a></li>
        <li><a href="/blog">Blog</a></li>
      </ul>
    </div>

    <div class="footer-column">
      <h3>Connect</h3>
      <ul class="footer-links">
        <li><a href="/contact">Contact</a></li>
        <li><a href="/location">Location</a></li>
