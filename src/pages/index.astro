---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Hughey LLC',
  url: 'https://hugheyllc.com',
  telephone: '727-483-3222',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '5412 Dover St NE',
    addressLocality: 'St. Petersburg',
    addressRegion: 'FL',
    postalCode: '33703',
    addressCountry: 'US',
  },
  sameAs: [
    'https://linkedin.com/company/hughey-llc',
    'https://facebook.com/hugheyllc',
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Law Firm Marketing Consultant Tampa Bay | Hughey LLC</title>
    <meta name="description" content="Hughey LLC provides strategic legal marketing services for law firms. 20+ years of data-driven strategies to increase retained clients." />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://hugheyllc.com" />
    <meta property="og:title" content="Law Firm Marketing Consultant Tampa Bay | Hughey LLC" />
    <meta property="og:description" content="Strategic legal marketing services for law firms." />
    <meta property="og:url" content="https://hugheyllc.com" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <link rel="stylesheet" href="/styles/global.css" />
    <style>
      :root {
        --ink: #09131E;
        --navy: #122340;
        --mid: #1E3A6E;
        --gold: #BE8830;
        --gl: #D4A048;
        --gcream: #F2E0B8;
        --amber: #FBF5E8;
        --cream: #F4EDE0;
        --page: #FAFAF7;
        --white: #FFFFFF;
        --text: #0D1A2A;
        --sub: #4A5568;
        --dim: #8896A7;
        --border: #DFD5C8;
        --ok: #1A9E6B;
        --f: system-ui, sans-serif;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--f);
        color: var(--text);
        background-color: var(--page);
        line-height: 1.6;
      }

      .skip-to-content {
        position: absolute;
        top: -40px;
        left: 0;
        background: var(--navy);
        color: var(--white);
        padding: 0.5rem 1rem;
        z-index: 100;
      }

      .skip-to-content:focus {
        top: 0;
      }

      :focus-visible {
        outline: 2px solid var(--gold);
        outline-offset: 2px;
      }

      .hero {
        height: 100vh;
        background: var(--navy);
        color: var(--white);
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 2rem;
      }

      .hero-content h1 {
        font-size: clamp(2rem, 8vw, 5rem);
        font-weight: 800;
        margin-bottom: 1rem;
        line-height: 1.1;
      }

      .hero-content p {
        font-size: 1.25rem;
        margin-bottom: 2rem;
        color: rgba(255, 255, 255, 0.9);
      }

      .hero-cta {
        display: inline-block;
        padding: 1rem 2rem;
        background: var(--gold);
        color: var(--ink);
        font-weight: 600;
        border-radius: 4px;
        text-decoration: none;
        transition: all 0.3s ease;
      }

      .hero-cta:hover {
        background: var(--gl);
      }

      .section {
        padding: 6rem 2rem;
        max-width: 1280px;
        margin: 0 auto;
      }

      .section h2 {
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 2rem;
        color: var(--text);
      }

      .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        margin: 2rem 0;
      }

      .card {
        background: var(--white);
        border: 1px solid var(--border);
        padding: 2rem;
        border-radius: 8px;
        transition: all 0.3s ease;
      }

      .card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
      }

      .card h3 {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 1rem;
        color: var(--text);
      }

      .card p {
        color: var(--sub);
        line-height: 1.8;
      }

      .services-section {
        background: var(--navy);
        color: var(--white);
      }

      .services-section h2 {
        color: var(--white);
      }

      .service-row {
        padding: 2rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.3s ease;
      }

      .service-row:hover {
        background: rgba(212, 160, 72, 0.08);
      }

      .service-row h3 {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--white);
      }

      .service-row p {
        color: rgba(255, 255, 255, 0.8);
      }

      footer {
        background: var(--ink);
        color: var(--white);
        padding: 4rem 2rem 2rem;
        margin-top: 6rem;
      }

      footer h3 {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 1rem;
        color: var(--gold);
      }

      footer a {
        color: rgba(255, 255, 255, 0.8);
        text-decoration: none;
        transition: color 0.3s ease;
      }

      footer a:hover {
        color: var(--gold);
      }

      .footer-content {
        max-width: 1280px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 3rem;
        margin-bottom: 2rem;
      }

      .footer-bottom {
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        padding-top: 2rem;
        text-align: center;
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.6);
        max-width: 1280px;
        margin: 0 auto;
      }
    </style>
  </head>
  <body>
    <a href="#main" class="skip-to-content">Skip to content</a>

    <!-- Hero Section -->
    <section class="hero" data-hero>
      <div class="hero-content">
        <h1>Legal Marketing for Law Firms</h1>
        <p>20+ years focused exclusively on legal marketing. Data-driven strategies that connect your marketing spend to retained clients.</p>
        <a href="/contact" class="hero-cta">Schedule a Free Strategy Call →</a>
        <p style="margin-top: 2rem; font-size: 0.9rem; color: rgba(255, 255, 255, 0.7);">
          St. Petersburg, FL · <a href="tel:727-483-3222" style="color: var(--gold);">727-483-3222</a> · 1-Business-Day Response
        </p>
      </div>
    </section>

    <!-- Services Section -->
    <section class="section services-section">
      <h2>What We Do</h2>
      <div class="service-row">
        <h3>Data Analysis & Reporting</h3>
        <p>Custom dashboards connecting marketing spend to retained clients.</p>
      </div>
      <div class="service-row">
        <h3>Agency Management</h3>
        <p>Oversight and optimization of your existing marketing vendors.</p>
      </div>
      <div class="service-row">
        <h3>Intake Process Optimization</h3>
        <p>Audit and redesign your client acquisition funnel.</p>
      </div>
      <div class="service-row">
        <h3>Strategic Marketing Planning</h3>
        <p>Comprehensive strategy aligned with your firm's growth goals.</p>
      </div>
    </section>

    <!-- Insights Section -->
    <section class="section">
      <h2>Latest Insights</h2>
      <div class="cards-grid">
        <div class="card">
          <h3>Law Firm Marketing Operating System</h3>
          <p>Build a systematic approach to marketing that creates consistency and measurable growth.</p>
          <a href="/insights" style="color: var(--navy); font-weight: 600;">Read More →</a>
        </div>
        <div class="card">
          <h3>SEO for Law Firms in an AI Search World</h3>
          <p>How AI search engines are changing legal SEO and what law firms need to do about it.</p>
          <a href="/insights" style="color: var(--navy); font-weight: 600;">Read More →</a>
        </div>
        <div class="card">
          <h3>Building an Intake System That Converts</h3>
          <p>Where your marketing leads actually disappear and how to fix it.</p>
          <a href="/insights" style="color: var(--navy); font-weight: 600;">Read More →</a>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="section" style="background: var(--gold); color: var(--ink); text-align: center;">
      <h2 style="color: var(--ink);">Ready to Build Marketing That Actually Works?</h2>
      <p style="color: var(--ink); margin-bottom: 2rem;">No pitch. No deck. Just a conversation about your firm's marketing.</p>
      <a href="/contact" class="hero-cta" style="background: var(--navy); color: var(--white);">Schedule a Free Strategy Call →</a>
    </section>

    <!-- Footer -->
    <footer>
      <div class="footer-content">
        <div>
          <h3>About</h3>
          <p>Legal marketing consultancy serving law firms across the nation.</p>
          <p style="margin-top: 1rem; font-size: 0.9rem;">
            5412 Dover St NE<br />
            St. Petersburg, FL 33703<br />
            <a href="tel:727-483-3222">727-483-3222</a>
          </p>
        </div>
        <div>
          <h3>Services</h3>
          <ul style="list-style: none;">
            <li><a href="/services/data-analysis-for-law-firms">Data Analysis</a></li>
            <li><a href="/services/agency-management-for-law-firms">Agency Management</a></li>
            <li><a href="/services/intake-process-optimization">Intake Optimization</a></li>
            <li><a href="/services/strategic-marketing-for-law-firms">Strategic Marketing</a></li>
          </ul>
        </div>
        <div>
          <h3>Explore</h3>
          <ul style="list-style: none;">
            <li><a href="/about">About</a></li>
            <li><a href="/insights">Insights</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div>
          <h3>Legal</h3>
          <ul style="list-style: none;">
            <li><a href="/location">Location</a></li>
            <li><a href="/privacy-policy">Privacy Policy</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <p>&copy; 2025 Hughey LLC. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
