---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  schema?: Record<string, any>;
  date?: string;
  author?: string;
}

const { title, description, canonical, schema, date, author = 'Joe Hughey' } = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema}>
  <article class="blog-post">
    <div class="post-header">
      <h1 class="post-title">{title}</h1>
      {date && (
        <div class="post-meta">
          <time datetime={date}>{new Date(date).toLocaleDateString()}</time>
          {author && <span>by {author}</span>}
        </div>
      )}
    </div>

    <div class="post-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .blog-post { max-width: 800px; margin: 4rem auto 6rem; padding: 0 2rem; }
  .post-header { margin-bottom: 3rem; }
  .post-title { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 800; line-height: 1.1; margin-bottom: 1rem; color: var(--text); }
  .post-meta { display: flex; gap: 1.5rem; font-size: 0.9rem; color: var(--dim); }
  .post-content { font-size: 1.05rem; line-height: 1.8; color: var(--text); }
  .post-content :global(h2) { font-size: 1.8rem; font-weight: 700; margin: 2rem 0 1rem; color: var(--text); }
  .post-content :global(p) { margin-bottom: 1rem; }
  .post-content :global(a) { color: var(--navy); text-decoration: underline; text-decoration-color: var(--gold); }
</style>
